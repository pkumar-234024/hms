# ──────────────────────────────────────────────────────────
# Example environment file
# Copy to .env.development.local or .env.production.local
# and fill in your values. Files ending in .local are
# git-ignored and safe for secrets.
# ──────────────────────────────────────────────────────────

# Backend API base URL
VITE_API_BASE_URL=https://localhost:57679

# Application name
VITE_APP_NAME=HMS — Hospital Management System

# Logging & DevTools
VITE_ENABLE_LOGGING=true
VITE_ENABLE_DEVTOOLS=true
