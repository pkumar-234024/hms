# ──────────────────────────────────────────────────────────
# DEVELOPMENT environment variables
# Loaded when running `npm run dev` (mode = "development")
# ──────────────────────────────────────────────────────────

# Backend API base URL (local .NET API with HTTPS dev cert)
VITE_API_BASE_URL=https://localhost:57679

# Enable verbose logging in the browser console
VITE_ENABLE_LOGGING=true

# Show Redux DevTools
VITE_ENABLE_DEVTOOLS=true
